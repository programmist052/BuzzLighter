<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable> 
    <StartupObject>Program</StartupObject>
    <PublishAot>False</PublishAot>
	<CustomResourceTypesSupport>true</CustomResourceTypesSupport>
	<ApplicationIcon>S600xU_2x-_1_.ico</ApplicationIcon>
	<ApplicationManifest>bin\Release\net10.0-windows\publish\win-x64\manifest.xml</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\1.mp4" />
    <None Remove="Resources\2.mp4" />
    <None Remove="Resources\3.mp4" />
    <None Remove="Resources\4.mp4" />
    <None Remove="Resources\5.mp4" />
    <None Remove="Resources\i-_17_.bmp" />
    <None Remove="Resources\notmyfaultc64.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="S600xU_2x-_1_.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\4.mp4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\1.mp4" />
    <EmbeddedResource Include="Resources\2.mp4" />
    <EmbeddedResource Include="Resources\3.mp4" />
    <EmbeddedResource Include="Resources\5.mp4" />
    <EmbeddedResource Include="Resources\i-_17_.bmp" />
    <EmbeddedResource Include="Resources\notmyfaultc64.exe" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
